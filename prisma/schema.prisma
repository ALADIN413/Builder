generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  IDEA
  RESEARCH
  BUILDING
  TESTING
  LAUNCHED
  GROWING
  PAUSED
  KILLED
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum EvidenceType {
  GITHUB
  LIVE_PRODUCT
  SCREENSHOT
  DOCUMENT
  CUSTOMER
  PAYMENT
  METRIC
  OTHER
}

enum DistractionCategory {
  YOUTUBE
  SOCIAL_MEDIA
  GAMING
  ENTERTAINMENT
  RANDOM_BROWSING
  MESSAGING
  OTHER
}

model User {
  id        String   @id @default(cuid())
  name      String
  emoji     String   @default("👤")
  isHead    Boolean  @default(false)
  teamId    String?
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dailyLogs        DailyLog[]
  focusSessions    FocusSession[]
  distractions     Distraction[]
  skills           Skill[]
  projects         Project[]
  businessMetrics  BusinessMetric[]
  weeklyReviews    WeeklyReview[]
  monthlyReviews   MonthlyReview[]
  evidence         Evidence[]

  @@index([teamId])
}

model Team {
  id                        String   @id @default(cuid())
  name                      String   @default("My Team")
  eodMeetingTime            String   @default("17:00")
  eodMeetingDurationMinutes Int      @default(30)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  members User[]
}

model DailyLog {
  id                        String   @id @default(cuid())
  userId                    String
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                      DateTime
  primaryObjective          String   @default("")
  deepWorkMinutes           Int      @default(0)
  technicalGrowth           Int?
  outputScore               Int?
  businessScore             Int?
  disciplineScore           Int?
  focusScore                Int?
  whatWentWell              String?
  whatWentWrong             String?
  whatIAmAvoiding           String?
  highestLeverageNextAction String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@unique([userId, date])
  @@index([date])
}

model FocusSession {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime
  startTime       DateTime?
  endTime         DateTime?
  durationMinutes Int
  objective       String
  accomplishment  String?
  output          String?
  blocker         String?
  focusScore      Int?
  evidenceUrl     String?
  evidenceType    EvidenceType?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId, date])
}

model Distraction {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  category  DistractionCategory
  minutes   Int
  note      String?
  createdAt DateTime            @default(now())

  @@index([userId, date])
}

model Skill {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  level       Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  evidence    SkillEvidence[]

  @@unique([userId, name])
}

model SkillEvidence {
  id          String       @id @default(cuid())
  skillId     String
  skill       Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)
  title       String
  type        EvidenceType
  url         String
  description String?
  createdAt   DateTime     @default(now())
}

model Project {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  status           ProjectStatus     @default(IDEA)
  startDate        DateTime?
  targetDate       DateTime?
  primaryObjective String?
  currentMilestone String?
  nextAction       String?
  users            Int               @default(0)
  revenue          Float             @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  milestones       ProjectMilestone[]

  @@index([userId])
}

model ProjectMilestone {
  id            String           @id @default(cuid())
  projectId     String
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  status        MilestoneStatus  @default(PLANNED)
  targetDate    DateTime?
  completedDate DateTime?
  evidenceUrl   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model BusinessMetric {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date               DateTime
  peopleContacted    Int      @default(0)
  conversations      Int      @default(0)
  problemsDiscovered Int      @default(0)
  demos              Int      @default(0)
  trials             Int      @default(0)
  payingCustomers    Int      @default(0)
  revenue            Float    @default(0)
  retention          Float    @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([userId, date])
}

model WeeklyReview {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStartDate         DateTime
  deepWorkSessions      Int      @default(0)
  deepWorkMinutes       Int      @default(0)
  avgFocus              Float    @default(0)
  projectsProgressed    Int      @default(0)
  projectsShipped       Int      @default(0)
  peopleContacted       Int      @default(0)
  customerConversations Int      @default(0)
  payingCustomers       Int      @default(0)
  revenue               Float    @default(0)
  distractionMinutes    Int      @default(0)
  avgFounderScore       Float    @default(0)
  accomplished          String?
  notAccomplished       String?
  avoiding              String?
  wastedTime            String?
  mostLeverage          String?
  stopDoing             String?
  startDoing            String?
  nextObjective         String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([userId, weekStartDate])
}

model MonthlyReview {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month                 String
  deepWorkMinutes       Int      @default(0)
  outputScore           Float    @default(0)
  technicalCapability   Float    @default(0)
  projectsCount         Int      @default(0)
  users                 Int      @default(0)
  customers             Int      @default(0)
  revenue               Float    @default(0)
  customerConversations Int      @default(0)
  distractionMinutes    Int      @default(0)
  avgFounderScore       Float    @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([userId, month])
}

model Evidence {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  type        EvidenceType
  url         String
  description String?
  relatedType String?
  relatedId   String?
  createdAt   DateTime     @default(now())

  @@index([userId])
}
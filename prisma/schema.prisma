generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum ProjectStatus {
  IDEA
  RESEARCH
  BUILDING
  TESTING
  LAUNCHED
  GROWING
  PAUSED
  KILLED
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum EvidenceType {
  GITHUB
  LIVE_PRODUCT
  SCREENSHOT
  DOCUMENT
  CUSTOMER
  PAYMENT
  METRIC
  OTHER
}

enum DistractionCategory {
  YOUTUBE
  SOCIAL_MEDIA
  GAMING
  ENTERTAINMENT
  RANDOM_BROWSING
  MESSAGING
  OTHER
}

model DailyLog {
  id                       String   @id @default(cuid())
  date                     DateTime @unique
  primaryObjective         String   @default("")
  deepWorkMinutes          Int      @default(0)
  technicalGrowth          Int?
  outputScore              Int?
  businessScore            Int?
  disciplineScore          Int?
  focusScore               Int?
  whatWentWell             String?
  whatWentWrong            String?
  whatIAmAvoiding          String?
  highestLeverageNextAction String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model FocusSession {
  id              String       @id @default(cuid())
  date            DateTime
  startTime       DateTime?
  endTime         DateTime?
  durationMinutes Int
  objective       String
  accomplishment  String?
  output          String?
  blocker         String?
  focusScore      Int?
  evidenceUrl     String?
  evidenceType    EvidenceType?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Distraction {
  id        String              @id @default(cuid())
  date      DateTime
  category  DistractionCategory
  minutes   Int
  note      String?
  createdAt DateTime            @default(now())
}

model Skill {
  id          String          @id @default(cuid())
  name        String          @unique
  description String?
  level       Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  evidence    SkillEvidence[]
}

model SkillEvidence {
  id          String       @id @default(cuid())
  skillId     String
  skill       Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)
  title       String
  type        EvidenceType
  url         String
  description String?
  createdAt   DateTime     @default(now())
}

model Project {
  id               String            @id @default(cuid())
  name             String
  description      String?
  status           ProjectStatus     @default(IDEA)
  startDate        DateTime?
  targetDate       DateTime?
  primaryObjective String?
  currentMilestone String?
  nextAction       String?
  users            Int               @default(0)
  revenue          Float             @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  milestones       ProjectMilestone[]
}

model ProjectMilestone {
  id            String           @id @default(cuid())
  projectId     String
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  status        MilestoneStatus  @default(PLANNED)
  targetDate    DateTime?
  completedDate DateTime?
  evidenceUrl   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model BusinessMetric {
  id                 String   @id @default(cuid())
  date               DateTime @unique
  peopleContacted    Int      @default(0)
  conversations      Int      @default(0)
  problemsDiscovered Int      @default(0)
  demos              Int      @default(0)
  trials             Int      @default(0)
  payingCustomers    Int      @default(0)
  revenue            Float    @default(0)
  retention          Float    @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model WeeklyReview {
  id                    String   @id @default(cuid())
  weekStartDate         DateTime @unique
  deepWorkSessions      Int      @default(0)
  deepWorkMinutes       Int      @default(0)
  avgFocus              Float    @default(0)
  projectsProgressed    Int      @default(0)
  projectsShipped       Int      @default(0)
  peopleContacted       Int      @default(0)
  customerConversations Int      @default(0)
  payingCustomers       Int      @default(0)
  revenue               Float    @default(0)
  distractionMinutes    Int      @default(0)
  avgFounderScore       Float    @default(0)
  accomplished          String?
  notAccomplished       String?
  avoiding              String?
  wastedTime            String?
  mostLeverage          String?
  stopDoing             String?
  startDoing            String?
  nextObjective         String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model MonthlyReview {
  id                    String   @id @default(cuid())
  month                 String   @unique
  deepWorkMinutes       Int      @default(0)
  outputScore           Float    @default(0)
  technicalCapability   Float    @default(0)
  projectsCount         Int      @default(0)
  users                 Int      @default(0)
  customers             Int      @default(0)
  revenue               Float    @default(0)
  customerConversations Int      @default(0)
  distractionMinutes    Int      @default(0)
  avgFounderScore       Float    @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Evidence {
  id          String       @id @default(cuid())
  title       String
  type        EvidenceType
  url         String
  description String?
  relatedType String?
  relatedId   String?
  createdAt   DateTime     @default(now())
}